// Cloudflare Workers config, used only when deploying to Cloudflare
// (npm run cf:deploy). Vercel ignores this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "coffee-pause-card",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference; the service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "coffee-pause-card"
    }
  ],
  "observability": { "enabled": true }
}
