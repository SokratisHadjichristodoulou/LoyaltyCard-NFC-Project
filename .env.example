# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this site, e.g. https://card.example.com
NEXT_PUBLIC_SITE_URL=

# Supabase project (feat/database-auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign and verify NFC tag URLs (feat/tag-verification)
NFC_TAG_SECRET=

# Secret used to sign coupon QR payloads (feat/customer-coupon)
COUPON_SIGNING_SECRET=

# Comma-separated emails allowed into /staff and /admin
STAFF_EMAILS=
ADMIN_EMAILS=
