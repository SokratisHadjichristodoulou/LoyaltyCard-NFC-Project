# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this site, used in sign-in emails, e.g. https://card.example.com
# (leave empty locally; http://localhost:3000 is detected)
NEXT_PUBLIC_SITE_URL=

# Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The anon (or "publishable") key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role (or "secret") key. Server only; never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Which cafe this site serves (cafes.slug). Defaults to coffee-pause-cyprus.
CAFE_SLUG=

# Dev only: set to 1 to preview card states with mock data instead of the database.
MOCK_DATA=

# Dev only: set to 1 to show an "Add a test stamp" button on the card (no NFC needed).
DEV_STAMPS=

# Secret every NFC tag key is derived from. Server only. Generate once with:
#   openssl rand -hex 32
# Changing it means reprogramming every tag.
NFC_TAG_SECRET=

# Google Wallet (optional; see README, Google Wallet). Server only.
# The Issuer ID from the Google Pay & Wallet Console:
GOOGLE_WALLET_ISSUER_ID=
# The service account's JSON key file, pasted whole on one line:
GOOGLE_WALLET_KEY=
# Lets the daily job (.github/workflows/wallet-daily.yml) call /api/wallet/daily (Google and Apple).
# Generate with: openssl rand -hex 32
WALLET_CRON_SECRET=

# Apple Wallet (optional; see README, Wallet passes). Server only.
# Paste PEM files whole (line breaks included), or with \n for each line break.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
# The Pass Type ID certificate and its unencrypted private key (PEM):
APPLE_WALLET_CERT=
APPLE_WALLET_KEY=
# Apple's "Worldwide Developer Relations - G4" intermediate certificate (PEM):
APPLE_WALLET_WWDR=
# The APNs auth key (.p8) and its Key ID, for update pushes:
APPLE_APNS_KEY_ID=
APPLE_APNS_KEY=
