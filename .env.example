# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this site, used in sign-in emails, e.g. https://card.example.com
# (leave empty locally; http://localhost:3000 is detected)
NEXT_PUBLIC_SITE_URL=

# Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The anon (or "publishable") key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role (or "secret") key. Server only; never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Which cafe this site serves (cafes.slug). Defaults to coffee-pause-cyprus.
CAFE_SLUG=

# Dev only: set to 1 to preview card states with mock data instead of the database.
MOCK_DATA=

# Dev only: set to 1 to show an "Add a test stamp" button on the card (no NFC needed).
DEV_STAMPS=

# Secret every NFC tag key is derived from. Server only. Generate once with:
#   openssl rand -hex 32
# Changing it means reprogramming every tag.
NFC_TAG_SECRET=
